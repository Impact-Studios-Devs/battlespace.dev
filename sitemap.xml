---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.html_pages | sort: "url" -%}
{%- for p in pages %}{% if p.url != "/404.html" %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>{% if p.url == "/" %}1.0{% elsif p.url contains "battlespace" %}0.9{% else %}0.6{% endif %}</priority>
  </url>
{% endif %}{% endfor %}
</urlset>
